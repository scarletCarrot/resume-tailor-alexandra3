# OpenRouter (required)
OPENROUTER_API_KEY=
# Optional override; default is deepseek/deepseek-v4-flash
# OPENROUTER_MODEL=

# Upstash Redis — company duplicate detection (optional; fails open if unset)
# Create a free Redis DB at https://console.upstash.com and paste REST credentials.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
